---
// Set di icone a tratto (24x24), disegnate per il sito.
import { ICONE } from '../lib/icone.mjs';

interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls } = Astro.props;
const icone: Record<string, string> = ICONE;


---
<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icone[name] ?? icone.spark}
/>
